generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: conexión pooled (host con "-pooler") — la usa la app en runtime.
  url       = env("DATABASE_URL")
  // DIRECT_URL: conexión directa (sin pooler) — la usa el CLI de Prisma para migraciones.
  // En desarrollo local (Docker) puede apuntar a la misma URL que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum ShowtimeStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  BOOKING_CLOSED
  CANCELLED
  FINISHED
}

enum ReservationStatus {
  PENDING_PAYMENT
  PAYMENT_APPROVED
  CONFIRMED
  CHECKED_IN
  CANCELLED
  EXPIRED
  REFUNDED
  NO_SHOW
}

enum PaymentMethod {
  ONLINE
  CASH
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

// Módulo de asiento físico (sofá) de la sala. La sala tiene un layout fijo:
// módulos "pareja" (1.50m, base 2 personas) y "trío" (2.00m, base 3
// personas). Un número limitado de piezas auxiliares (0.50m, ver
// Setting "auxiliary_module_count") puede añadirse a UN módulo para sumarle
// 1 persona — nunca crean un cupo independiente.
enum VenueModuleType {
  COUPLE
  TRIO
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Core catalog
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs           AuditLog[]
  paymentsConfirmed   Payment[]                 @relation("PaymentConfirmedBy")
  statusChanges       ReservationStatusHistory[]
  checkIns            CheckIn[]
  cancelledReservations Reservation[]           @relation("ReservationCancelledBy")

  @@map("admin_users")
}

model Movie {
  id              String   @id @default(cuid())
  title           String
  description     String
  posterUrl       String?
  bannerUrl       String?
  durationMinutes Int
  genre           String
  rating          String
  trailerUrl      String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  showtimes Showtime[]

  @@map("movies")
}

model Showtime {
  id            String         @id @default(cuid())
  movieId       String
  movie         Movie          @relation(fields: [movieId], references: [id])
  startsAt      DateTime // instante UTC del inicio de función (derivado de fecha+hora America/Bogota)
  capacity      Int
  status        ShowtimeStatus @default(DRAFT)
  weekPublished Boolean        @default(false) // pertenece a una semana ya publicada
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Función especial: precio de menú fijo por persona, con imagen/aviso
  // promocional propio. El cliente ve el aviso y reserva directo a ese
  // precio, sin elegir entre los productos normales (General/Combo/etc).
  isSpecial          Boolean @default(false)
  specialAdImageUrl  String?
  specialMenuPrice   Int? // COP por persona, solo aplica si isSpecial = true
  specialDescription String? // por qué es especial (mostrado en el aviso)

  // TicketType oculto autogenerado que representa el "menú especial" de esta
  // función, usado internamente para crear el ReservationItem (mantiene todo
  // el historial de precios/reportes funcionando igual que un producto normal).
  specialTicketTypeId String?     @unique
  specialTicketType    TicketType? @relation("SpecialTicketType", fields: [specialTicketTypeId], references: [id])

  reservations       Reservation[]
  ticketTypeOverrides ShowtimeTicketType[]

  @@index([startsAt])
  @@index([status])
  @@map("showtimes")
}

model TicketType {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int // en pesos COP, entero
  includes    String[] // lista de items incluidos
  active      Boolean  @default(true)
  hidden      Boolean  @default(false) // no aparece en Productos ni en el sitio público (ej. menús especiales autogenerados)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservationItems  ReservationItem[]
  showtimeOverrides ShowtimeTicketType[]
  specialForShowtime Showtime? @relation("SpecialTicketType")

  @@map("ticket_types")
}

/**
 * Habilita/deshabilita productos específicos para una función puntual. Si una
 * función NO tiene ninguna fila aquí, aplica el comportamiento por defecto:
 * todos los productos activos están disponibles (compatibilidad con
 * funciones ya creadas). Si tiene al menos una fila, SOLO esos productos
 * están disponibles para esa función.
 */
model ShowtimeTicketType {
  id           String     @id @default(cuid())
  showtimeId   String
  showtime     Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([showtimeId, ticketTypeId])
  @@map("showtime_ticket_types")
}

// ---------------------------------------------------------------------------
// Layout físico de la sala (módulos de asiento)
// ---------------------------------------------------------------------------

model VenueModule {
  id           String          @id @default(cuid())
  type         VenueModuleType
  label        String // "Módulo pareja 1", "Módulo trío A"...
  baseCapacity Int // 2 (pareja) o 3 (trío), sin auxiliar
  sortOrder    Int             @default(0)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  assignments ReservationModuleAssignment[]

  @@map("venue_modules")
}

// Qué módulo(s) ocupa una reserva para una función dada, y si consumió una
// de las piezas auxiliares compartidas. Se deriva siempre de las reservas
// activas (igual que el resto de la disponibilidad) — nunca se "libera"
// manualmente, desaparece solo cuando la reserva deja de contar (cancelada,
// expirada) porque la fila completa se borra en cascada con la reserva.
model ReservationModuleAssignment {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  venueModuleId String
  venueModule   VenueModule @relation(fields: [venueModuleId], references: [id])
  seatsOccupied Int // baseCapacity, o baseCapacity + 1 si usesAuxiliary
  usesAuxiliary Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@map("reservation_module_assignments")
}

// ---------------------------------------------------------------------------
// Customers & Reservations
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  whatsapp  String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@index([whatsapp])
  @@index([email])
  @@map("customers")
}

model Reservation {
  id         String            @id @default(cuid())
  code       String            @unique
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  showtimeId String
  showtime   Showtime          @relation(fields: [showtimeId], references: [id])

  adults   Int
  children Int

  totalAmount Int
  status      ReservationStatus @default(PENDING_PAYMENT)
  source      String            @default("WEB") // WEB | ADMIN_MANUAL | WHATSAPP | PHONE | WALK_IN

  expiresAt DateTime?

  qrToken String? @unique

  cancelledAt   DateTime?
  cancelReason  String?
  cancelledById String?
  cancelledBy   AdminUser? @relation("ReservationCancelledBy", fields: [cancelledById], references: [id])

  rescheduledFromId String?
  rescheduledFrom   Reservation?  @relation("ReservationReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo     Reservation[] @relation("ReservationReschedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             ReservationItem[]
  payments          Payment[]
  statusHistory     ReservationStatusHistory[]
  checkIn           CheckIn?
  notifications     Notification[]
  moduleAssignments ReservationModuleAssignment[]

  @@index([showtimeId, status])
  @@index([status, expiresAt])
  @@map("reservations")
}

model ReservationItem {
  id            String   @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType  @relation(fields: [ticketTypeId], references: [id])

  ticketTypeName String // snapshot del nombre al momento de la reserva
  quantity       Int
  unitPrice      Int // snapshot histórico del precio
  total          Int

  @@map("reservation_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id            String        @id @default(cuid())
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id])

  method   PaymentMethod
  status   PaymentStatus @default(PENDING)
  amount   Int

  providerReference String? // referencia enviada a la pasarela
  providerTxId      String? // id de transacción en la pasarela
  rawResponse       Json?

  confirmedById String?
  confirmedBy   AdminUser? @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  cashReference String? // referencia opcional para efectivo/transferencia

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions PaymentTransaction[]

  @@index([reservationId])
  @@map("payments")
}

// Log de eventos de la pasarela (webhooks) para garantizar idempotencia.
model PaymentTransaction {
  id                   String   @id @default(cuid())
  paymentId            String
  payment              Payment  @relation(fields: [paymentId], references: [id])
  provider             String
  providerTransactionId String
  eventType            String
  payload              Json
  receivedAt           DateTime @default(now())

  @@unique([provider, providerTransactionId, eventType])
  @@map("payment_transactions")
}

// ---------------------------------------------------------------------------
// History / Operations
// ---------------------------------------------------------------------------

model ReservationStatusHistory {
  id            String            @id @default(cuid())
  reservationId String
  reservation   Reservation       @relation(fields: [reservationId], references: [id])
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  reason        String?
  changedById   String?
  changedBy     AdminUser?        @relation(fields: [changedById], references: [id])
  changedAt     DateTime          @default(now())

  @@map("reservation_status_history")
}

model CheckIn {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  checkedInAt   DateTime    @default(now())
  checkedInById String?
  checkedInBy   AdminUser?  @relation(fields: [checkedInById], references: [id])
  method        String      @default("QR")

  @@map("check_ins")
}

model Notification {
  id            String              @id @default(cuid())
  reservationId String
  reservation   Reservation         @relation(fields: [reservationId], references: [id])
  channel       NotificationChannel
  event         String // RESERVATION_CONFIRMED | REMINDER_24H | REMINDER_2H | ...
  status        NotificationStatus  @default(PENDING)
  payload       Json?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@map("notifications")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
