# Base de datos (contenedor Docker mapeado a 5433 para no chocar con un Postgres local en 5432)
# Se usa 127.0.0.1 en vez de localhost para evitar resolución IPv6 problemática en Windows/Docker Desktop
DATABASE_URL="postgresql://cine:cine_dev_password@127.0.0.1:5433/cine_respiro"
# En producción con Neon: DATABASE_URL = conexión "pooled" (host con -pooler),
# DIRECT_URL = conexión directa (sin pooler, la usa `prisma migrate`).
# En desarrollo local ambas pueden apuntar a la misma base de Docker.
DIRECT_URL="postgresql://cine:cine_dev_password@127.0.0.1:5433/cine_respiro"

# App
APP_BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
TIMEZONE="America/Bogota"

# Autenticación admin
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# QR firmado (HMAC) - separado de JWT_SECRET
QR_SIGNING_SECRET="change-me-to-another-long-random-string"

# Cron de expiración de reservas pendientes
CRON_SECRET="change-me-cron-secret"

# Reservas
RESERVATION_HOLD_MINUTES=15
CASH_RESERVATION_HOLD_HOURS=24

# Pasarela de pago: "mock" (desarrollo, sin credenciales), "wompi" o "bold"
PAYMENT_PROVIDER="mock"

# Credenciales Wompi (https://docs.wompi.co) — solo requeridas si PAYMENT_PROVIDER=wompi
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_API_URL="https://production.wompi.co/v1"

# Credenciales Bold (https://developers.bold.co) — solo requeridas si PAYMENT_PROVIDER=bold
# El QR Bre-B aparece automáticamente en el checkout si activas "QR Pro" en tu cuenta Bold.
BOLD_API_KEY=""
BOLD_WEBHOOK_SECRET=""
BOLD_API_URL="https://integrations.api.bold.co"
BOLD_VOUCHER_API_URL="https://payments.api.bold.co/v2"

# Notificaciones por email (Resend — https://resend.com)
NOTIFICATIONS_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Cine Respiro <reservas@cinerespiro.com>"
# Correo del negocio que recibe el aviso de cada venta con los datos del cliente
BUSINESS_SALES_EMAIL="ventas@example-respiro.com"
WHATSAPP_API_KEY=""

# Semilla de admin inicial (usada por prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@cinerespiro.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123!"
